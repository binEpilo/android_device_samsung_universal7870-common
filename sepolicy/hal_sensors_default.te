# hal_sensors_default.te

# cgroup tasks
allow hal_sensors_default cgroup:file getattr;

# Sensors access specific sysfs types via Samsung SLSI common policy
# (sysfs_iio, sysfs_sec_sensors, sysfs_sensors_writable, sysfs_spi_writeable,
#  sysfs_lcd_writable, sysfs_input, sysfs_sensors, sysfs_sec_key, sysfs_sec_touchscreen,
#  sysfs_touchscreen_writable)

# SSP sensorhub enable (under /sys/devices/virtual/sensors/)
allow hal_sensors_default sysfs_virtual:dir search;
allow hal_sensors_default sysfs_sensors_writable:file rw_file_perms;

# IIO sensor buffer enable (write needed for buffer control)
allow hal_sensors_default sysfs_iio:file r_file_perms;
