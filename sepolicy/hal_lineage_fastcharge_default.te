# hal_lineage_fastcharge_default.te

# Fastcharge HAL reads/writes specific sysfs nodes
allow hal_lineage_fastcharge_default sysfs_virtual:dir search;
allow hal_lineage_fastcharge_default sysfs_sec_switch:dir search;
allow hal_lineage_fastcharge_default sysfs_sec_switch:file r_file_perms;
allow hal_lineage_fastcharge_default sysfs_sec_switch_writable:file rw_file_perms;

get_prop(hal_lineage_fastcharge, sec_fastcharge_prop)
set_prop(hal_lineage_fastcharge, sec_fastcharge_prop)
